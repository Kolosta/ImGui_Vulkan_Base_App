{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (MinGW Makefiles, portable)",
            "description": "Portable preset: gcc/g++ resolved from PATH (MSYS2 mingw64). No machine-specific paths. Override locally via CMakeUserPresets.json.",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ci",
            "inherits": "default",
            "displayName": "CI (GitHub Actions)",
            "description": "Used by .github/workflows/ci.yml. Identical to default; kept separate so CI intent is explicit and the local 'default' can be overridden freely.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build (Debug)",
            "configurePreset": "default"
        },
        {
            "name": "ci",
            "displayName": "CI Build (Debug)",
            "configurePreset": "ci"
        }
    ]
}
