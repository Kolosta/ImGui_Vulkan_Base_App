# ── Build output ──────────────────────────────────────────────────────────────
build/
cmake-build-*/
out/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vs/
.idea/
*.swp
*.swo
*~

# ── Compiled objects ──────────────────────────────────────────────────────────
*.o
*.obj
*.exe
*.out
*.app

# ── CMake artifacts ───────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ── Machine-local CMake presets (absolute toolchain/vcpkg paths) ──────────────
# CMakePresets.json is portable and tracked; per-developer overrides go here.
CMakeUserPresets.json

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Auto-downloaded dependencies ──────────────────────────────────────────────
_deps/

# ── Runtime state (written by the app, not source) ────────────────────────────
design_system.bin
imgui.ini
shortcuts.dat

# ── Generated files (produced by build steps) ─────────────────────────────────
resvg_c.h
# Compiled shaders (GLSL → SPIR-V via glslc). The .vert/.frag sources are
# tracked; the .spv output is a build artifact.
*.spv

# ── Test project files (the .acu document format is user data, not source) ────
*.acu

# ── Temporary token generator (NEVER a source of truth) ───────────────────────
# The token schema is hand-edited in TokenIds.h / TokenSchema.cpp. This Python
# scratchpad is throwaway tooling and must never be committed or relied upon.
.tmp_tokengen/

# ── Build / debug logs ────────────────────────────────────────────────────────
*.log
build_err.log

# ── Machine-local editor/agent settings (tracked settings.json stays) ──
.claude/settings.local.json
